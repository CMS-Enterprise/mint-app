{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "rootDir": ".",
    "jsx": "react-jsx",
    "noCheck": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["mappings/export/exportTranslation.ts", "mappings/export/util.ts"]
}
