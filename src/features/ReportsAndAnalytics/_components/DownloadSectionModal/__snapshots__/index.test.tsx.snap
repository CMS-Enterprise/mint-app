                    value="OMB_ASRF_CLEARANCE"
                  />
                  <label
                    class="usa-checkbox__label"
                    for="status-OMB_ASRF_CLEARANCE"
                  >
                    In OMB clearance
                  </label>
                </div>
                <div
                  class="usa-checkbox"
                  data-testid="checkbox"
                >
                  <input
                    class="usa-checkbox__input"
                    id="status-CLEARED"
                    name="CLEARED"
                    type="checkbox"
                    value="CLEARED"
                  />
                  <label
                    class="usa-checkbox__label"
                    for="status-CLEARED"
                  >
                    Cleared
                  </label>
                </div>
                <div
                  class="usa-checkbox"
                  data-testid="checkbox"
                >
                  <input
                    class="usa-checkbox__input"
                    id="status-ANNOUNCED"
