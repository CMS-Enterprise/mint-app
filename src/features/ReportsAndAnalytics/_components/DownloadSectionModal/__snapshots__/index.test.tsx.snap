                >
                  <input
                    class="usa-checkbox__input"
                    id="other-MODELS_I_FOLLOW"
                    name="MODELS_I_FOLLOW"
                    type="checkbox"
                    value="MODELS_I_FOLLOW"
                  />
                  <label
                    class="usa-checkbox__label"
                    for="other-MODELS_I_FOLLOW"
