                    value="CANCELED"
                  />
                  <label
                    class="usa-checkbox__label"
                    for="status-CANCELED"
                  >
                    Canceled
                  </label>
                </div>
              </div>
            </fieldset>
            <fieldset
              class="usa-fieldset mint-filter-group font-body-sm margin-bottom-2 border-bottom-1px border-base-light padding-bottom-4 border-bottom-0 margin-bottom-3 padding-bottom-0"
              data-testid="fieldset"
            >
              <legend>
                <h3
                  class="margin-y-1 font-body-sm margin-top-0 margin-bottom-neg-2"
                >
                  Other categories
