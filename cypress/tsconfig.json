{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["cypress", "node"]
  },
  "include": [
    "plugins/index.ts",
    "types/cypress-otp.d.ts",
    "../cypress.config.ts",
    "../src/config/global.d.ts"
  ]
}
