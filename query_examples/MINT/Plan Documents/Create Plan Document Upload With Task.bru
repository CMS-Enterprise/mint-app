meta {
  name: Create Plan Document Upload With Task
  type: graphql
  seq: 4
}

post {
  url: {{url}}
  body: graphql
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: Local {"EUAID":"{{EUAID}}","jobCodes":{{jobCodes}},"favorLocalAuth":true}
  placement: header
}

body:graphql {
  mutation uploadNewPlanDocument ($input: PlanDocumentInput!) {
      uploadNewPlanDocument (input: $input) {
          id
          planTaskID
          fileName
      }
  }
}

body:graphql:vars {
  {
    "input": {
      "modelPlanID": "{{modelPlanID}}",
      "fileData": "Hello!",
      "documentType": "CONCEPT_PAPER",
      "restricted": false,
      "planTaskID": "{{planTaskID}}"
    }
  }
}

script:post-response {
  let responseData = res.getBody().data.uploadNewPlanDocument

  let documentID = responseData.id

  bru.setVar("documentID", documentID);
}
