meta {
  name: Create CTAT Discussion
  type: graphql
  seq: 7
}

post {
  url: {{url}}
  body: graphql
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: Local {"EUAID":"{{EUAID}}","jobCodes":{{jobCodes}},"favorLocalAuth":true}
  placement: header
}

body:graphql {
  mutation createDiscussion($input: CTATDiscussionInput!) {
    createDiscussion(input: $input) {
      id
      ticketID
      content
      posterRole
      createdBy
      createdByUserAccount {
        id
        username
        commonName
      }
      createdDts
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "ticketID": "{{ctatRequestID}}",
      "content": "Bruno example discussion on a CTAT ticket."
    }
  }
}

vars:pre-request {
  EUAID: BTAL
  jobCodes: ["MINT_USER_NONPROD"]
}

tests {
  let responseData = res.getBody().data.createDiscussion

  bru.setVar("ctatDiscussionID", responseData.id);
}
