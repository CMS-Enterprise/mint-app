meta {
  name: Get Plan Tasks
  type: graphql
  seq: 1
}

post {
  url: {{url}}
  body: graphql
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: Local {"EUAID":"{{EUAID}}","jobCodes":{{jobCodes}},"favorLocalAuth":true}
  placement: header
}

body:graphql {
  query modelPlan ($id: UUID!) {
      modelPlan (id: $id) {
          id
          modelName
          tasks {
              id
              key
              status
              state
              completedBy
              completedByUserAccount {
                  id
                  username
              }
              completedDts
              documents {
                  id
                  fileName
                  fileType
                  documentType
                  planTaskID
              }
          }
      }
  }
}

body:graphql:vars {
  {
    "id": "{{modelPlanID}}"
  }
}

script:post-response {
  const tasks = res.getBody().data.modelPlan.tasks;
  const twoPagerTask = tasks.find(task => task.key === "TWO_PAGER");

  if (twoPagerTask) {
    bru.setVar("planTaskID", twoPagerTask.id);
  }
}
