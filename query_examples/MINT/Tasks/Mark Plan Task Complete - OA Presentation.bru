meta {
  name: Mark Plan Task Complete - OA Presentation
  type: graphql
  seq: 4
}

post {
  url: {{url}}
  body: graphql
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: Local {"EUAID":"{{EUAID}}","jobCodes":{{jobCodes}},"favorLocalAuth":true}
  placement: header
}

body:graphql {
  mutation markPlanTaskComplete {
  markPlanTaskComplete(modelPlanID: "{{modelPlanID}}",
  key: OA_PRESENTATION,
  isComplete: true)
      {
          id
          key
          status
          state
          completedBy
          completedByUserAccount {
              id
              username
          }
          completedDts
      }
  }
}
